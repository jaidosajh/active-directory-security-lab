<Sysmon schemaversion="4.90">
  <!-- Lab example: collect PowerShell process and network activity only. -->
  <EventFiltering>
    <RuleGroup name="PowerShell process creation" groupRelation="or">
      <ProcessCreate onmatch="include">
        <Image condition="end with">\powershell.exe</Image>
        <Image condition="end with">\pwsh.exe</Image>
      </ProcessCreate>
    </RuleGroup>
    <RuleGroup name="PowerShell network connections" groupRelation="or">
      <NetworkConnect onmatch="include">
        <Image condition="end with">\powershell.exe</Image>
        <Image condition="end with">\pwsh.exe</Image>
      </NetworkConnect>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
